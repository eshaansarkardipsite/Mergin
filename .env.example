# Server
NODE_ENV=development
PORT=3001

# Public origin of the React app (used for customer payment links and CORS)
APP_BASE_URL=http://localhost:5173

# SQLite file location
DATABASE_URL=file:./dev.db

# PayPal REST API (Sandbox by default). Leave blank to run in demo mode.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the PayPal Developer Dashboard (required for signature verification)
PAYPAL_WEBHOOK_ID=
# Optional public HTTPS base URL for webhook docs/links
PUBLIC_WEBHOOK_BASE_URL=

# Google Gemini (backend only). Leave blank to use the deterministic offline explanation.
GEMINI_API_KEY=
GEMINI_MODEL=

# Session secret used to sign the demo session cookie (generate a long random value)
SESSION_SECRET=
