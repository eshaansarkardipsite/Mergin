# Copy to .env and fill in what you have. Every value is optional in development;
# with none set the app runs in a clearly labelled local demo mode.

# --- Server ---
NODE_ENV=development
PORT=3001
# Set to 1 when the API runs behind exactly one reverse proxy (nginx, Caddy, a PaaS edge).
TRUST_PROXY=0
# Public origin of the React app (payment links, OAuth redirects, webhook fallback).
APP_BASE_URL=http://localhost:5173
# SQLite file used until the Supabase data migration lands.
DATABASE_URL=file:./dev.db
# Required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Supabase (project settings -> API) ---
# Auth uses the project URL and anon key. The service-role key stays server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
# Authorised redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# Paste the same client ID and secret into Supabase -> Authentication -> Providers -> Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- PayPal (developer.paypal.com -> Apps & Credentials -> Sandbox -> your app) ---
# Client ID + secret come from the app's Credentials tab. Leave blank for demo mode.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the app's Webhooks tab. Create one for the endpoint below with
# INVOICING.INVOICE.PAID, UPDATED, REFUNDED, CANCELLED, CREATED, SENT and SCHEDULED.
PAYPAL_WEBHOOK_ID=
# Public HTTPS origin PayPal can reach. Falls back to APP_BASE_URL.
# Endpoint: <origin>/api/paypal/webhook
PUBLIC_WEBHOOK_BASE_URL=

# --- AI Copilot ---
# OpenRouter is the production explanation provider (Phase 3 migration).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Legacy Gemini provider. Remove once the OpenRouter migration is complete.
GEMINI_API_KEY=
GEMINI_MODEL=
